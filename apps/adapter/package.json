{
  "name": "@openclaw-wrapper/adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./src/server.ts",
    "./router": "./src/routers/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@openclaw-wrapper/memory-sdk": "workspace:*",
    "@openclaw-wrapper/node-sdk": "workspace:*",
    "@openclaw-wrapper/openclaw-client": "workspace:*",
    "@openclaw-wrapper/schemas": "workspace:*",
    "@sinclair/typebox": "^0.34.9",
    "@trpc/server": "^11.17.0",
    "bullmq": "^5.76.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@openclaw-wrapper/tsconfig": "workspace:*",
    "@types/node": "^25.7.0",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
