# Core server settings
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55433/openclaw
REDIS_URL=redis://127.0.0.1:56379

# OpenClaw gateway connection
GATEWAY_WS_URL=ws://127.0.0.1:18789
GATEWAY_TOKEN=
GATEWAY_BOOTSTRAP_TOKEN=
GATEWAY_DEVICE_TOKEN=
GATEWAY_PASSWORD=

# Authentication mode
# AUTH_MODE=disabled is the recommended local OSS mode.
# Use AUTH_MODE=required for team/hosted deployments.
AUTH_MODE=disabled
LOCAL_AUTH_EMAIL=local@openclaw-wrapper.local
LOCAL_AUTH_NAME=Local User

# Network and logging
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Plugin and workspace paths
OPENCLAW_WORKSPACE_DIR=
OPENCLAW_PLUGIN_DIR=

# Optional live web-search providers
BRAVE_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# Optional ClawHub integration
CLAWHUB_BASE_URL=https://clawhub.ai
CLAWHUB_TOKEN=

# Secret storage and public URLs
# Change this before sharing the adapter with other machines.
CHANNEL_SECRET_KEY=change-me-to-a-long-random-secret
APP_BASE_URL=http://localhost:3000
ADAPTER_BASE_URL=http://localhost:4000

# Email delivery
# outbox = local/dev email preview mode
EMAIL_DELIVERY_MODE=outbox
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_AUTH=
EMAIL_FROM=OpenClaw Wrapper <no-reply@openclaw-wrapper.local>

# Optional exec-node policy
# EXEC_NODE_ENABLED=true
# EXEC_NODE_ALLOW_TRUSTED=false
# EXEC_NODE_ALLOW_ELEVATED=false
# EXEC_NODE_ALLOWED_COMMAND_PREFIXES=
# EXEC_NODE_TRUSTED_ALLOWED_COMMAND_PREFIXES=
# EXEC_NODE_ELEVATED_ALLOWED_COMMAND_PREFIXES=
# EXEC_NODE_ALLOWED_COMMAND_FAMILIES=
# EXEC_NODE_TRUSTED_ALLOWED_COMMAND_FAMILIES=
# EXEC_NODE_ELEVATED_ALLOWED_COMMAND_FAMILIES=
